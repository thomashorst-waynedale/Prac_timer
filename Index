    <!-- Firebase SDK Setup & Realtime Timer Engine -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, doc, setDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const firebaseConfig = typeof __firebase_config !== 'undefined' 
            ? JSON.parse(__firebase_config) 
            : { apiKey: "", authDomain: "", projectId: "ms-football-planner", storageBucket: "", messagingSenderId: "", appId: "" };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'ms-football-planner';

        let currentUser = null;
        let isRemoteUpdate = false;
        window.savedHistory = [];

        // Global Timer Synchronized State
        window.syncedTimer = {
            activePeriodIndex: 0,
            isRunning: false,
            endTimeMs: 0,
            remainingSeconds: 600
        };

        const initAuth = async () => {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.error("Auth init error:", err);
            }
        };
        initAuth();

        onAuthStateChanged(auth, (user) => {
            currentUser = user;
            if (user) {
                setupRealtimeStaffListeners();
            }
        });

        function setupRealtimeStaffListeners() {
            // Shared History Collection Listener
            const historyColRef = collection(db, 'artifacts', appId, 'public', 'data', 'practice_history');
            onSnapshot(historyColRef, (snapshot) => {
                const list = [];
                snapshot.forEach(docSnap => {
                    list.push({ id: docSnap.id, ...docSnap.data() });
                });
                list.sort((a, b) => new Date(b.createdAt || b.date) - new Date(a.createdAt || a.date));
                window.savedHistory = list;
                renderHistoryList();
            }, (err) => console.error("History snapshot error:", err));

            // Shared Practice & Timer Sync Listener
            const activeDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'active_practice', 'current');
            onSnapshot(activeDocRef, (docSnap) => {
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    if (data.lastUpdatedBy !== currentUser?.uid) {
                        isRemoteUpdate = true;
                        if (data.date) document.getElementById('practiceDate').value = data.date;
                        if (data.startTime) document.getElementById('startTime').value = data.startTime;
                        if (data.gear) document.getElementById('gearSelect').value = data.gear;
                        if (data.todayFocus !== undefined) document.getElementById('todayFocus').value = data.todayFocus;
                        if (data.yesterdayGood !== undefined) document.getElementById('yesterdayGood').value = data.yesterdayGood;
                        if (data.yesterdayBad !== undefined) document.getElementById('yesterdayBad').value = data.yesterdayBad;
                        if (data.staffNotes !== undefined) document.getElementById('staffNotes').value = data.staffNotes;
                        
                        if (data.periods && Array.isArray(data.periods)) {
                            window.periods = JSON.parse(JSON.stringify(data.periods));
                        }
                        renderSchedule();
                        isRemoteUpdate = false;
                    }

                    // Process Synced Timer State from Cloud
                    if (data.syncedTimer) {
                        handleIncomingSyncedTimer(data.syncedTimer);
                    }
                }
            }, (err) => console.error("Live active practice snapshot error:", err));
        }

        function handleIncomingSyncedTimer(incoming) {
            window.syncedTimer = incoming;
            window.activePeriodIndex = incoming.activePeriodIndex || 0;
            
            if (incoming.isRunning) {
                const now = Date.now();
                const diffSecs = Math.max(0, Math.round((incoming.endTimeMs - now) / 1000));
                window.timerSeconds = diffSecs;
            } else {
                window.timerSeconds = incoming.remainingSeconds || 0;
            }

            setupTimerPeriodDisplay();
            updateTimerButtonUI(incoming.isRunning);

            if (incoming.isRunning && !window.timerInterval) {
                startLocalTimerTick();
            } else if (!incoming.isRunning && window.timerInterval) {
                clearInterval(window.timerInterval);
                window.timerInterval = null;
            }
        }

        window.syncActivePracticeToCloud = async function(timerDataToUpdate = null) {
            if (!currentUser || isRemoteUpdate) return;
            try {
                const activeDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'active_practice', 'current');
                
                const payload = {
                    date: document.getElementById('practiceDate').value,
                    startTime: document.getElementById('startTime').value,
                    gear: document.getElementById('gearSelect').value,
                    todayFocus: document.getElementById('todayFocus').value,
                    yesterdayGood: document.getElementById('yesterdayGood').value,
                    yesterdayBad: document.getElementById('yesterdayBad').value,
                    staffNotes: document.getElementById('staffNotes').value,
                    totalMinutes: calculateTimes().totalMinutes,
                    periods: window.periods,
                    syncedTimer: timerDataToUpdate || window.syncedTimer,
                    lastUpdatedBy: currentUser.uid,
                    lastUpdatedAt: new Date().toISOString()
                };

                await setDoc(activeDocRef, payload);
            } catch (err) {
                console.error("Cloud sync error:", err);
            }
        };

        window.saveCurrentPractice = async function() {
            if (!currentUser) {
                showToast("Connecting to cloud...", false);
                return;
            }

            const practiceData = {
                date: document.getElementById('practiceDate').value,
                startTime: document.getElementById('startTime').value,
                gear: document.getElementById('gearSelect').value,
                todayFocus: document.getElementById('todayFocus').value,
                yesterdayGood: document.getElementById('yesterdayGood').value,
                yesterdayBad: document.getElementById('yesterdayBad').value,
                staffNotes: document.getElementById('staffNotes').value,
                totalMinutes: calculateTimes().totalMinutes,
                periods: window.periods,
                createdAt: new Date().toISOString(),
                createdBy: currentUser.uid
            };

            try {
                const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'practice_history');
                await addDoc(colRef, practiceData);
                showToast("Saved to Staff Log!", true);
            } catch (err) {
                console.error("Save error:", err);
                showToast("Save failed", false);
            }
        };

        window.deleteHistoryRecord = async function(docId) {
            if (!currentUser) return;
            showConfirmModal("Delete this record from shared staff history?", async () => {
                try {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'practice_history', docId);
                    await deleteDoc(docRef);
                    showToast("Record Deleted!", true);
                } catch (err) {
                    console.error("Delete error:", err);
                }
            });
        };
    </script>

    <!-- Main Application UI & Timer Sync Mechanics -->
    <script>
        const DEFAULT_PRACTICE_BLOCKS = [
            { id: 1, title: "Warm Up", duration: 10, isFixed: true, options: ["Dynamic Warmup"], selectedDrills: ["Dynamic Warmup"], customNotes: "", attachedFiles: [] },
            { id: 2, title: "Blood Pumper", duration: 10, isFixed: false, options: ["Take Off", "Pursuit", "Other"], selectedDrills: ["Take Off"], customNotes: "", attachedFiles: [] },
            { id: 3, title: "Indy / Group", duration: 20, isFixed: false, options: ["O Indy", "D Indy", "Form Rec", "Install"], selectedDrills: ["O Indy"], customNotes: "", attachedFiles: [] },
            { id: 4, title: "Stations / Team Build", duration: 20, isFixed: false, options: ["Ball Skills", "Blocking", "Tackling", "Team Builder"], selectedDrills: ["Ball Skills"], customNotes: "", attachedFiles: [] },
            { id: 5, title: "Group / Team", duration: 30, isFixed: false, options: ["7 on 7 with Inside Run", "Team"], selectedDrills: ["7 on 7 with Inside Run"], customNotes: "", attachedFiles: [] },
            { id: 6, title: "Conditioning", duration: 15, isFixed: false, options: ["10 10s", "Gassers", "Fartlek", "Champions"], selectedDrills: ["10 10s"], customNotes: "", attachedFiles: [] },
            { id: 7, title: "Team Announcements", duration: 15, isFixed: false, options: ["Game Prep", "Equipment Check", "Next Practice Info", "Parent/Roster Reminders"], selectedDrills: ["Game Prep"], customNotes: "", attachedFiles: [] }
        ];

        window.periods = JSON.parse(JSON.stringify(DEFAULT_PRACTICE_BLOCKS));
        window.activePeriodIndex = 0;
        window.timerSeconds = 600;
        window.timerInterval = null;

        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('practiceDate').valueAsDate = new Date();
            document.getElementById('todayFocus').value = "Execution & Fundamentals";
            document.getElementById('yesterdayGood').value = "Great hustle during 7v7";
            document.getElementById('yesterdayBad').value = "Tackling angles & Huddle tempo";
            renderSchedule();
            lucide.createIcons();
        });

        function calculateTimes() {
            const startInput = document.getElementById('startTime').value || "15:00";
            const [startHour, startMin] = startInput.split(':').map(Number);
            let currentTime = new Date();
            currentTime.setHours(startHour, startMin, 0, 0);

            let totalMinutes = 0;

            const timeMapped = window.periods.map(p => {
                const startTimeStr = formatTime(currentTime);
                const dur = parseInt(p.duration) || 0;
                totalMinutes += dur;

                currentTime.setMinutes(currentTime.getMinutes() + dur);
                const endTimeStr = formatTime(currentTime);

                return {
                    ...p,
                    startTimeStr,
                    endTimeStr
                };
            });

            document.getElementById('totalTimeBadge').textContent = `Total: ${totalMinutes} mins`;
            return { timeMapped, totalMinutes };
        }

        function formatTime(dateObj) {
            let hours = dateObj.getHours();
            let minutes = dateObj.getMinutes();
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            minutes = minutes < 10 ? '0' + minutes : minutes;
            return `${hours}:${minutes} ${ampm}`;
        }

        function renderSchedule() {
            const { timeMapped } = calculateTimes();
            const container = document.getElementById('periodsContainer');
            container.innerHTML = '';

            const editablePeriods = timeMapped.slice(1);

            editablePeriods.forEach((period, actualIdx) => {
                const idx = actualIdx + 1;
                const optionsList = period.options || [];
                const filesList = period.attachedFiles || [];

                const card = document.createElement('div');
                card.className = "bg-white rounded-xl border border-slate-200 p-3 shadow-2xs hover:border-slate-300 transition print-card space-y-3";

                card.innerHTML = `
                    <div class="flex flex-wrap justify-between items-center gap-2 pb-2 border-b border-slate-100">
                        <div class="flex items-center gap-2">
                            <span class="bg-slate-900 text-white text-[11px] font-black px-2 py-0.5 rounded">
                                #${idx}
                            </span>
                            <input type="text" value="${escapeHtml(period.title)}" onchange="updatePeriodTitle(${idx}, this.value)" class="font-extrabold text-slate-800 text-sm bg-transparent focus:bg-slate-50 focus:outline-none rounded px-1">
                        </div>

                        <div class="flex items-center gap-2">
                            <span class="text-xs font-mono font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded">
                                ${period.startTimeStr} - ${period.endTimeStr}
                            </span>

                            <div class="flex items-center gap-1 bg-slate-50 rounded-lg p-0.5 border border-slate-200">
                                <button onclick="adjustTime(${idx}, -5)" class="no-print hover:bg-white text-slate-700 px-2 py-0.5 rounded font-black text-xs transition">-5</button>
                                <input type="number" value="${period.duration}" min="0" onchange="updatePeriodDuration(${idx}, this.value)" class="w-10 text-center text-xs font-black bg-white rounded border border-slate-200 py-0.5 focus:outline-none">
                                <span class="text-xs text-slate-400 font-bold pr-1">m</span>
                                <button onclick="adjustTime(${idx}, 5)" class="no-print hover:bg-white text-slate-700 px-2 py-0.5 rounded font-black text-xs transition">+5</button>
                            </div>

                            <button onclick="openTimerModalForPeriod(${idx})" class="no-print bg-amber-400 hover:bg-amber-300 text-slate-950 p-1 rounded-lg text-xs font-bold transition" title="Start Timer">
                                <i data-lucide="timer" class="w-4 h-4"></i>
                            </button>

                            <button onclick="deletePeriod(${idx})" class="no-print text-slate-300 hover:text-rose-500 p-1 rounded-lg hover:bg-rose-50 transition">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Quick Drill Tag Options -->
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="block text-[10px] font-black text-slate-400 uppercase tracking-wider">
                                Quick Select Tag:
                            </label>
                            <button onclick="addDrillOptionPrompt(${idx})" class="no-print text-emerald-600 text-[11px] font-bold flex items-center gap-1">
                                + Add Tag
                            </button>
                        </div>

                        <div class="flex flex-wrap gap-1.5">
                            ${optionsList.map(drill => {
                                const isSelected = (period.selectedDrills || []).includes(drill);
                                return `
                                    <button 
                                        onclick="selectDrill(${idx}, '${escapeHtml(drill)}')" 
                                        class="text-xs px-2.5 py-1 rounded-lg font-bold border transition ${
                                            isSelected 
                                                ? 'bg-emerald-600 text-white border-emerald-600 shadow-2xs' 
                                                : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'
                                        }"
                                    >
                                        ${isSelected ? '✓ ' : ''}${escapeHtml(drill)}
                                    </button>
                                `;
                            }).join('')}
                        </div>
                    </div>

                    <!-- Coaching Script / Notes Field -->
                    <div class="flex items-center gap-2">
                        <input type="text" value="${escapeHtml(period.customNotes || '')}" onchange="updatePeriodNotes(${idx}, this.value)" placeholder="Specific coaching points / play script details..." class="w-full text-xs font-medium bg-slate-50 border border-slate-200 rounded-lg p-2 text-slate-800 focus:outline-none focus:border-emerald-500">
                    </div>

                    <!-- Attachments Bar -->
                    <div class="pt-1.5 border-t border-slate-100 flex items-center justify-between">
                        <div class="flex items-center gap-2 flex-wrap">
                            ${filesList.map((file, fileIdx) => `
                                <div class="bg-slate-100 border border-slate-200 rounded-md px-2 py-0.5 text-[10px] font-bold text-slate-700 flex items-center gap-1">
                                    <span>📎 ${escapeHtml(file.name)}</span>
                                    <button onclick="removeAttachedFile(${idx}, ${fileIdx})" class="no-print text-slate-400 hover:text-rose-500">✕</button>
                                </div>
                            `).join('')}
                        </div>

                        <label class="no-print cursor-pointer text-[11px] font-bold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded-lg transition flex items-center gap-1">
                            <i data-lucide="paperclip" class="w-3 h-3"></i> Attach File
                            <input type="file" class="hidden" accept="*/*" onchange="handleFileUpload(${idx}, this)">
                        </label>
                    </div>
                `;

                container.appendChild(card);
            });

            lucide.createIcons();
        }

        function selectDrill(idx, drill) {
            window.periods[idx].selectedDrills = [drill];
            renderSchedule();
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
        }

        function addDrillOptionPrompt(idx) {
            const val = prompt("Enter new tag/drill name:");
            if (val && val.trim()) {
                if (!window.periods[idx].options) window.periods[idx].options = [];
                window.periods[idx].options.push(val.trim());
                window.periods[idx].selectedDrills = [val.trim()];
                renderSchedule();
                if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
            }
        }

        function updatePeriodTitle(idx, val) {
            window.periods[idx].title = val;
            renderSchedule();
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
        }

        function updatePeriodDuration(idx, val) {
            window.periods[idx].duration = Math.max(0, parseInt(val) || 0);
            renderSchedule();
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
        }

        function adjustTime(idx, delta) {
            window.periods[idx].duration = Math.max(0, (parseInt(window.periods[idx].duration) || 0) + delta);
            renderSchedule();
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
        }

        function updatePeriodNotes(idx, val) {
            window.periods[idx].customNotes = val;
            renderSchedule();
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
        }

        function handleFileUpload(periodIdx, inputElement) {
            const file = inputElement.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                if (!window.periods[periodIdx].attachedFiles) {
                    window.periods[periodIdx].attachedFiles = [];
                }

                window.periods[periodIdx].attachedFiles.push({
                    name: file.name,
                    type: file.type || 'application/octet-stream',
                    size: file.size,
                    dataUrl: e.target.result
                });

                inputElement.value = ''; 
                renderSchedule();
                if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
            };
            reader.readAsDataURL(file);
        }

        function removeAttachedFile(periodIdx, fileIdx) {
            if (window.periods[periodIdx].attachedFiles) {
                window.periods[periodIdx].attachedFiles.splice(fileIdx, 1);
                renderSchedule();
                if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
            }
        }

        function deletePeriod(idx) {
            window.periods.splice(idx, 1);
            renderSchedule();
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
        }

        function addPeriod() {
            window.periods.push({
                id: Date.now(),
                title: "Custom Block",
                duration: 10,
                isFixed: false,
                options: ["Option A", "Option B"],
                selectedDrills: ["Option A"],
                customNotes: "",
                attachedFiles: []
            });
            renderSchedule();
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud();
        }

        // --- Real-time Synchronized Sideline Timer Controls ---
        function openTimerModal() {
            openTimerModalForPeriod(window.activePeriodIndex || 0);
        }

        function openTimerModalForPeriod(pIdx) {
            if (window.periods.length === 0) return;
            window.activePeriodIndex = pIdx;
            
            const current = window.periods[pIdx];
            window.timerSeconds = (parseInt(current.duration) || 0) * 60;
            
            setupTimerPeriodDisplay();
            
            document.getElementById('timerModal').classList.remove('hidden');
            document.getElementById('timerModal').classList.add('flex');
            lucide.createIcons();
        }

        function closeTimerModal() {
            document.getElementById('timerModal').classList.add('hidden');
            document.getElementById('timerModal').classList.remove('flex');
        }

        function setupTimerPeriodDisplay() {
            const current = window.periods[window.activePeriodIndex];
            if (!current) return;

            document.getElementById('timerPeriodBadge').textContent = `PERIOD ${window.activePeriodIndex + 1}`;
            document.getElementById('timerPeriodTitle').textContent = current.title.toUpperCase();

            const drillsText = (current.selectedDrills || []).join(', ') + (current.customNotes ? ` (${current.customNotes})` : '');
            document.getElementById('timerPeriodDrills').textContent = drillsText || "General Drills";

            updateTimerDisplay();

            const next = window.periods[window.activePeriodIndex + 1];
            if (next) {
                document.getElementById('nextPeriodTitle').textContent = `${next.title} — ${(next.selectedDrills || []).join(', ')}`;
                document.getElementById('nextPeriodTime').textContent = `${next.duration} Mins`;
            } else {
                document.getElementById('nextPeriodTitle').textContent = "End of Practice / Final Huddle";
                document.getElementById('nextPeriodTime').textContent = "0 Mins";
            }
        }

        function updateTimerDisplay() {
            const mins = Math.floor(window.timerSeconds / 60);
            const secs = window.timerSeconds % 60;
            document.getElementById('bigTimerDisplay').textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function updateTimerButtonUI(isRunning) {
            const btn = document.getElementById('playPauseBtn');
            if (!btn) return;
            btn.innerHTML = isRunning 
                ? `<i data-lucide="pause" class="w-6 h-6 fill-current"></i> PAUSE`
                : `<i data-lucide="play" class="w-6 h-6 fill-current"></i> START`;
            lucide.createIcons();
        }

        function toggleSyncedTimer() {
            const isCurrentlyRunning = window.syncedTimer.isRunning;
            const now = Date.now();

            if (!isCurrentlyRunning) {
                // Coach pressed START
                const endTimeMs = now + (window.timerSeconds * 1000);
                const updatedTimer = {
                    activePeriodIndex: window.activePeriodIndex,
                    isRunning: true,
                    endTimeMs: endTimeMs,
                    remainingSeconds: window.timerSeconds
                };
                window.syncedTimer = updatedTimer;
                if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud(updatedTimer);
            } else {
                // Coach pressed PAUSE
                const updatedTimer = {
                    activePeriodIndex: window.activePeriodIndex,
                    isRunning: false,
                    endTimeMs: 0,
                    remainingSeconds: window.timerSeconds
                };
                window.syncedTimer = updatedTimer;
                if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud(updatedTimer);
            }
        }

        function resetSyncedTimer() {
            const current = window.periods[window.activePeriodIndex];
            const secs = (parseInt(current?.duration) || 0) * 60;
            
            const updatedTimer = {
                activePeriodIndex: window.activePeriodIndex,
                isRunning: false,
                endTimeMs: 0,
                remainingSeconds: secs
            };
            window.syncedTimer = updatedTimer;
            if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud(updatedTimer);
        }

        function nextSyncedPeriod() {
            if (window.activePeriodIndex < window.periods.length - 1) {
                const nextIdx = window.activePeriodIndex + 1;
                const nextPeriodObj = window.periods[nextIdx];
                const secs = (parseInt(nextPeriodObj?.duration) || 0) * 60;

                const updatedTimer = {
                    activePeriodIndex: nextIdx,
                    isRunning: false,
                    endTimeMs: 0,
                    remainingSeconds: secs
                };
                window.syncedTimer = updatedTimer;
                if (window.syncActivePracticeToCloud) window.syncActivePracticeToCloud(updatedTimer);
            } else {
                showToast("Practice Complete! Great job Coach!", true);
            }
        }

        function startLocalTimerTick() {
            if (window.timerInterval) clearInterval(window.timerInterval);

            window.timerInterval = setInterval(() => {
                if (window.syncedTimer.isRunning) {
                    const now = Date.now();
                    const remaining = Math.max(0, Math.round((window.syncedTimer.endTimeMs - now) / 1000));
                    window.timerSeconds = remaining;
                    updateTimerDisplay();

                    if (remaining <= 0) {
                        clearInterval(window.timerInterval);
                        window.timerInterval = null;
                        playWhistle();
                        nextSyncedPeriod();
                    }
                }
            }, 1000);
        }

        function playWhistle() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();

                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(2800, ctx.currentTime);
                osc.frequency.linearRampToValueAtTime(3200, ctx.currentTime + 0.1);
                osc.frequency.linearRampToValueAtTime(2800, ctx.currentTime + 0.2);

                gain.gain.setValueAtTime(0, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.8, ctx.currentTime + 0.05);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.6);

                osc.connect(gain);
                gain.connect(ctx.destination);

                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.6);
            } catch (e) {
                console.log("Audio play blocked", e);
            }
        }

        function showToast(msg, isSuccess = true) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = msg;
            toastIcon.className = isSuccess ? "w-4 h-4 text-emerald-400" : "w-4 h-4 text-rose-400";
            
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function showConfirmModal(msg, onConfirm) {
            if (confirm(msg)) {
                onConfirm();
            }
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }
    </script>
</body>
</html>

